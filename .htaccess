# =============================================================
# Divine Rubber — Apache / cPanel configuration
# Security headers (required by the team QA checklist), caching, 404 page.
# Verify after upload:  curl -I https://your-domain/  (or securityheaders.com)
# =============================================================

Options -Indexes
ServerSignature Off
ErrorDocument 404 /404.html

# ---------- Force HTTPS (uncomment once the SSL certificate is active) ----------
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  # 1. Content-Security-Policy — only our own files + Google Maps embed
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"

  # 2. Strict-Transport-Security — only takes effect over HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # 3. Stop MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # 4. Clickjacking protection
  Header always set X-Frame-Options "SAMEORIGIN"

  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header unset X-Powered-By

  # STAGING ONLY — keeps search engines out. REMOVE this line on the production site.
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# ---------- Browser caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/json
</IfModule>

# ---------- Never serve source / tooling / reference files ----------
<FilesMatch "(\.(scss|fig|docx|md|jfif|JPG)|^Divinerubber\.pdf|^package(-lock)?\.json)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(node_modules|tools|partials|scss|source-images)(/|$)
